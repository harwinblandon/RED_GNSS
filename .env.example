# Autenticación (Supabase). Copiar este archivo a .env.local y rellenar.
# Se obtienen en el panel de Supabase → Project Settings → API.
# NO son secretos (la clave "anon" solo identifica el proyecto), pero se
# mantienen fuera del repositorio y se inyectan en el build desde secretos
# de GitHub. Si se dejan vacíos, la app funciona sin login (útil en local).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
